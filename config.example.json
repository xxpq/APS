    },
    "sucdri": {
      "servers": ["default"],
      "password": "sucdri"
    }
  },
  "endpoints": {
    "cjy_server": {
      "tunnelName": "sucdri",
      "endpointName": "cjy_server",
      "ssh": {
        "enabled": true,
        "port": 22222,
        "point_key": "~/.ssh/id_rsa",
        "users": [
          {
            "name": "user1",
            "password": "change-me",
            "keys": [
              "ssh-ed25519 AAAA..."
            ]
